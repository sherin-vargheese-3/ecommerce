# Copy to .env and adjust. docker compose reads .env automatically.

# PostgreSQL
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
DB_PORT=5432

# Backend
BACKEND_PORT=8080
# HS256 signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-please-32-bytes-min
JWT_EXPIRATION=PT1H
# Initial admin account, created on first startup if it does not exist
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=admin12345

# Frontend (nginx serving the built app, proxying /api to the backend)
FRONTEND_PORT=3000
